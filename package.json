{
  "name": "churp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "build": "node scripts/build-push-worker.js && vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "npm run build && npm test",
    "test:e2e": "playwright test",
    "setup:push": "node scripts/setup-push.js",
    "test:e2e:encryption": "playwright test -c playwright.encryption.config.js",
    "backup": "node server/backups/cli.js",
    "build:native": "node scripts/build-native.js",
    "native:sync": "npm run build:native && cap sync",
    "native:ios": "npm run native:sync && cap open ios",
    "native:android": "npm run native:sync && cap open android",
    "native:doctor": "node scripts/native-doctor.js",
    "native:assets": "capacitor-assets generate --assetPath native/assets --ios --android --iconBackgroundColor '#fcfaf3' --splashBackgroundColor '#fcfaf3' --splashBackgroundColorDark '#fcfaf3' --logoSplashScale 0.22",
    "build:native:release": "node scripts/build-native.js --release",
    "native:sync:release": "npm run build:native:release && cap sync"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/lib-storage": "^3.1164.0",
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-badge": "^8.0.4",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.59.0",
    "multer": "^2.4.0",
    "openpgp": "6.3.2",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "vite": "^7.3.7"
  }
}
