# Copy to .env for local development. Never commit .env.
PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=.data
# Optional: Google OAuth Web client ID. Add APP_URL as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
# Optional: generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
