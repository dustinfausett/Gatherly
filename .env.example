# Copy to .env for local development. Never commit .env.
PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=.data
# Optional managed-key master from your secret manager: 64 random hexadecimal characters.
# If omitted, Churp creates a persistent DATA_DIR/key-vault.key. Preserve it across redeploys.
# CHURP_KEY_VAULT_SECRET=
# Optional: Google OAuth Web client ID. Add APP_URL as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
# Optional: override the bird collection unlock code (defaults to Churp).
BIRD_UNLOCK_CODE=Churp
# Optional: generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional password-reset and recovery-email verification delivery.
# Verify your sending domain in Resend, then add these as Railway secrets.
RESEND_API_KEY=
CHURP_EMAIL_FROM=

# External SMS: disabled by default. Mock mode never calls Twilio.
SMS_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Conservative rolling-24-hour queued/attempted segment budget, not a provider invoice.
SMS_DAILY_SEGMENT_LIMIT=200
SMS_SENDER_DAILY_SEGMENT_LIMIT=50
SMS_DAILY_BUDGET_CENTS=1000
SMS_ESTIMATED_SEGMENT_COST_CENTS=5
# Live activation also needs explicit provider/consent readiness and an adult pilot scope.
# Do not set these for mock development; see docs/SMS.md.
SMS_LIVE_APPROVED=false
SMS_PILOT_TREE_ID=
SMS_LIVE_SENDER_IDS=
